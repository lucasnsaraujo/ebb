<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld accounts can't be read right now</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld account can't be read right now</string>
			<key>other</key>
			<string>%lld accounts can't be read right now</string>
		</dict>
	</dict>
	<key>CLIProxyAPI is still holding %lld accounts in cooldown.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>CLIProxyAPI is still holding %lld account in cooldown.</string>
			<key>other</key>
			<string>CLIProxyAPI is still holding %lld accounts in cooldown.</string>
		</dict>
	</dict>
	<key>The pool now has %lld accounts.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>The pool now has %lld account.</string>
			<key>other</key>
			<string>The pool now has %lld accounts.</string>
		</dict>
	</dict>
</dict>
</plist>
